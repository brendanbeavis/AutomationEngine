@using System.Globalization

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>[AE] Automation Engine</title>
    <base href="/" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="css/app.css?version=0.1">
    <link rel="stylesheet" type="text/css" href="css/cyberpunk.css?version=0.1">
    <link rel="stylesheet" type="text/css" href="css/themes.css?version=0.1">
    <link rel="stylesheet" type="text/css" href="AutomationEngine.styles.css?version=0.1" />
    <link href="_content/Blazicons/css/blazicons.min.css" rel="stylesheet" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">✕</a>
    </div>

    <script src="_framework/blazor.web.js"></script>
    <script src="js/theme-manager.js"></script>
    <script src="js/job-row-actions.js"></script>
</body>
</html>
