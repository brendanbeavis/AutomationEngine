@using AutomationEngine.Dto
@using AutomationEngine.Extensions

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-xl" style="max-width: 90%;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Job History - @JobId</h5>
                    <button type="button" class="btn-close cp-btn neon" aria-label="Close" @onclick="OnCloseClick"></button>
                </div>
                <div class="modal-body">
                    @if (Runs == null)
                    {
                        <p><em>Loading...</em></p>
                    }
                    else if (Runs.Count == 0)
                    {
                        <div class="alert alert-info">No runs found.</div>
                    }
                    else
                    {
                        <!-- Dashboard Metrics Section -->
                        <div class="job-history-dashboard mb-4">
                            <div class="dashboard-header mb-3">
                                <h6 class="neon-text" style="letter-spacing: 1px; margin-bottom: 0;">PERFORMANCE METRICS</h6>
                            </div>
                            <div class="metrics-grid">
                                <!-- Success Rate Card -->
                                <div class="metric-card cp-chamfer">
                                    <div class="metric-card-body">
                                        <div class="metric-label">Success Rate</div>
                                        <div class="metric-value" style="color: #39ff14;">@SuccessRate%</div>
                                        <div class="metric-bar">
                                            <div class="metric-bar-fill" style="width: @SuccessRate%; background: linear-gradient(90deg, #39ff14, #00fff6);"></div>
                                        </div>
                                        <div class="metric-subtext">
                                            <span class="text-success">✓ @(Runs.Count(r => r.Success))</span>
                                            <span class="text-muted mx-2">|</span>
                                            <span class="text-danger">✗ @(Runs.Count(r => !r.Success))</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Average Duration Card -->
                                <div class="metric-card cp-chamfer">
                                    <div class="metric-card-body">
                                        <div class="metric-label">Avg Duration</div>
                                        <div class="metric-value" style="color: #00fff6;">
                                            @{
                                                var avgMs = (int)AverageDuration;
                                                if (avgMs >= 1000)
                                                {
                                                    <span>@(avgMs / 1000.0)s</span>
                                                }
                                                else
                                                {
                                                    <span>@avgMs ms</span>
                                                }
                                            }
                                        </div>
                                        <div class="metric-info text-muted small mt-2">
                                            Based on @(Runs.Count(r => r.DurationMs.HasValue)) completed runs
                                        </div>
                                    </div>
                                </div>

                                <!-- Total Runs Card -->
                                <div class="metric-card cp-chamfer">
                                    <div class="metric-card-body">
                                        <div class="metric-label">Total Runs</div>
                                        <div class="metric-value" style="color: #ff2d95;">@TotalRuns</div>
                                        <div class="metric-info text-muted small mt-3">
                                            @(TotalRuns == 1 ? "1 execution" : $"{TotalRuns} executions")
                                        </div>
                                    </div>
                                </div>

                                <!-- Last Run Status Card -->
                                <div class="metric-card cp-chamfer">
                                    <div class="metric-card-body">
                                        <div class="metric-label">Last Run</div>
                                        <div class="metric-value">
                                            @if (LastRunSuccessful)
                                            {
                                                <span style="color: #39ff14;">SUCCESS</span>
                                            }
                                            else
                                            {
                                                <span style="color: #ff2d95;">FAILED</span>
                                            }
                                        </div>
                                        <div class="metric-info text-muted small mt-2">
                                            <span>@LastRunTime.ToLocalDisplayOr("N/A")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Job Run History Table -->
                        <div class="table-responsive">
                            <table class="table table-striped table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Started</th>
                                        <th>Duration</th>
                                        <th>Status</th>
                                        <th>Return Code</th>
                                        <th>Output</th>
                                        <th>Error Messages</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var run in Runs.OrderByDescending(r => r.StartedAt))
                                    {
                                        <tr>
                                            <td>@run.StartedAt.ToLocalDisplay()</td>
                                            <td>@(run.DurationMs.HasValue ? run.DurationMs.Value.MsToString() : "-")</td>
                                            <td>
                                                <span class="badge @run.Success.ToHistoryStatusBadgeClass()">
                                                    @run.Success.ToHistoryStatusText()
                                                </span>
                                            </td>
                                            <td>@run.ExitCode</td>
                                            <td><pre style="white-space: pre-wrap; max-height: 120px; overflow:auto;">@run.StdOut</pre></td>
                                            <td><pre style="white-space: pre-wrap; max-height: 120px; overflow:auto;">@run.StdErr</pre></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn badge bg-pink-neon" @onclick="OnCloseClick">✗ Close</button>
                </div>
            </div>
        </div>
    </div>
}
