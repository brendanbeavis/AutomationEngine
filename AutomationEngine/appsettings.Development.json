{
  "Database": {
    "Provider": "Sqlite",
    "FilePath": "AutomationEngine.db",
    "CommandTimeoutSeconds": 60,
    "PoolSize": 5,
    "EnablePoolPrewarming": false,
    "SqliteCacheQueryPlans": true,
    "SqliteEnableWal": false,
    "ValidateConnectionOnStartup": true,
    "MaxRetryAttempts": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
      "Microsoft.AspNetCore.Components": "Trace",
      "Microsoft.AspNetCore.SignalR": "Debug"
    }
  },
  "Resilience": {
    "RetryAttempts": 3,
    "BackoffBaseSeconds": 2,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerDurationSeconds": 30
  },
  "Scheduler": {
    "ReloadIntervalSeconds": 60,
    "LoopDelaySeconds": 5
  },
  "JobApi": {
    "HistoryLimit": 50
  },
  "DesignTimeDatabase": {
    "Provider": "Sqlite",
    "FilePath": "db\\AutomationEngine.db",
    "CommandTimeoutSeconds": 60,
    "PoolSize": 5,
    "SqliteEnableWal": false,
    "SqliteCacheQueryPlans": true
  },
  "DetailedErrors": true
}
