{
  "Database": {
    "Provider": "Sqlite",
    "FilePath": "AutomationEngine.db",
    "CommandTimeoutSeconds": 60,
    "PoolSize": 5,
    "EnablePoolPrewarming": false,
    "SqliteCacheQueryPlans": true,
    "SqliteEnableWal": false,
    "ValidateConnectionOnStartup": true,
    "MaxRetryAttempts": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
      "Microsoft.AspNetCore.Components": "Trace",
      "Microsoft.AspNetCore.SignalR": "Debug"
    }
  },
  "DetailedErrors": true
}
