{
  "Database": {
    "Provider": "Sqlite",
    "FilePath": "AutomationEngine.db",
    "CommandTimeoutSeconds": 30,
    "PoolSize": 10,
    "EnablePoolPrewarming": true,
    "SqliteCacheQueryPlans": true,
    "SqliteEnableWal": true,
    "ValidateConnectionOnStartup": true,
    "MaxRetryAttempts": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;*",
  "Server": {
    "Port": 5001
  },
  "Security": {
    "LocalhostOnly": true
  },
  "Resilience": {
    "RetryAttempts": 3,
    "BackoffBaseSeconds": 2,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerDurationSeconds": 30
  },
  "Scheduler": {
    "ReloadIntervalSeconds": 60,
    "LoopDelaySeconds": 5
  },
  "JobApi": {
    "HistoryLimit": 50
  },
  "DesignTimeDatabase": {
    "Provider": "Sqlite",
    "FilePath": "db\\AutomationEngine.db",
    "CommandTimeoutSeconds": 60,
    "PoolSize": 5,
    "SqliteEnableWal": false,
    "SqliteCacheQueryPlans": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProperty"
    ],
    "Properties": {
      "Application": "AutomationEngine",
      "Environment": "Production"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs\\automation-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs\\automation-structured-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "formatter": "Serilog.Formatting.Json.JsonFormatter"
        }
      }
    ]
  }
}
