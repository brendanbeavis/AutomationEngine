{
  "Database": {
    "Provider": "Sqlite",
    "FilePath": "AutomationEngine.db",
    "CommandTimeoutSeconds": 30,
    "PoolSize": 10,
    "EnablePoolPrewarming": true,
    "SqliteCacheQueryPlans": true,
    "SqliteEnableWal": true,
    "ValidateConnectionOnStartup": true,
    "MaxRetryAttempts": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;*",
  "Urls": "http://localhost:5000",
  "ApiBaseUrl": "http://localhost:5000/",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      }
    }
  },
  "Security": {
    "LocalhostOnly": true,
    "AdminSecret": null,
    "AdminSecretDescription": "If non-null, enables programmatic API access via X-Admin-Secret header. Set to a strong random string to enable (e.g., 'your-secret-key-here'). Requires localhost access. Leave null for UI-only access (default, recommended)."
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProperty"
    ],
    "Properties": {
      "Application": "AutomationEngine",
      "Environment": "Production"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs\\automation-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs\\automation-structured-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "formatter": "Serilog.Formatting.Json.JsonFormatter"
        }
      }
    ]
  },
  "Ntfy": {
    "Endpoint": "https://ntfy.sh/your-topic",
    "Enabled": false
  }
}
